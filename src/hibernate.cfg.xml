<hibernate-configuration>

<session-factory>
	
	<!-- conexion con la BD-->
<property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
<property name="connection.url">
jdbc:mysql://localhost:3306/objetos2?serverTimezone=America/Argentina/Buenos_Aires
</property>
<property name="connection.username">objetos2</property>
<property name="connection.password">objetos2</property>
<property name="connection.pool_size">1</property>
<property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>
<property name="hbm2ddl.auto">update</property>


<property name="show_sql">true</property>
<!-- en true muestra hql en consola-->
<property name="format_sql">true</property>

<mapping resource="mapeos/Staff.hbm.xml"/>
<!--mapping resource="mapeos/Evento.hbm.xml"/-->
</session-factory>


</hibernate-configuration>