<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="datos">

    <class name="UnidadDeVenta"
           table="unidad_de_venta"
           abstract="true">

        <id name="id"
            column="id"
            type="long">

            <generator class="identity"/>

        </id>

        <property name="nombreComercial"
                  column="nombre_comercial"
                  type="string"
                  not-null="true"/>

        <property name="superficie"
                  column="superficie"
                  type="integer"
                  not-null="true"/>

        <property name="codigoChico"
                  column="codigo_chico"
                  type="integer"
                  not-null="true"/>


        <many-to-one name="encargado"
                     class="Staff"
                     column="id_encargado"
                     not-null="true"
                     lazy="proxy"
                     fetch="select"/>



        <many-to-one name="festival"
                     class="Festival"
                     column="id_festival"
                     not-null="true"
                     lazy="proxy"
                     fetch="select"/>


        <set name="listaDePlatos"
             table="unidad_venta_plato"
             lazy="true"
             fetch="select">

            <key column="id_unidad_venta"/>

            <many-to-many class="Plato"
                          column="id_plato"/>

        </set>


        <set name="personal"
             table="unidad_venta_staff"
             lazy="true"
             fetch="select">

            <key column="id_unidad_venta"/>

            <many-to-many class="Staff"
                          column="id_staff"/>

        </set>


        <joined-subclass name="datos.FoodTruck"
                         table="food_truck">

            <key column="id"/>

            <property name="patente"
                      column="patente"
                      type="string"
                      not-null="true"/>

            <property name="usaElectricidad"
                      column="usa_electricidad"
                      type="boolean"
                      not-null="true"/>

        </joined-subclass>


        <joined-subclass name="datos.PuestoDesarmable"
                         table="puesto_desarmable">

            <key column="id"/>

            <property name="carpas"
                      column="carpas"
                      type="int"
                      not-null="true"/>

            <property name="tiempoMontaje"
                      column="tiempo_montaje"
                      type="int"
                      not-null="true"/>

        </joined-subclass>

    </class>

</hibernate-mapping>