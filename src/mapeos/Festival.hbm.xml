<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="datos">

    <class name="Festival" table="festival">

        <id name="id"
            column="id_festival"
            type="long">

            <generator class="identity"/>

        </id>

        <property name="nombre"
                  column="nombre"
                  type="string"
                  not-null="true"/>

        <property name="temporada"
                  column="temporada"
                  type="string"
                  not-null="true"/>

        <property name="fechaInicio"
                  column="fecha_inicio"
                  type="java.time.LocalDate"
                  not-null="true"/>

        <property name="fechaFin"
                  column="fecha_fin"
                  type="java.time.LocalDate"
                  not-null="true"/>

        <property name="costoSuperficie"
                  column="costo_superficie"
                  type="double"
                  not-null="true"/>

        <property name="costoMontaje"
                  column="costo_montaje"
                  type="double"
                  not-null="true"/>

        <property name="plusElectricidad"
                  column="plus_electricidad"
                  type="double"
                  not-null="true"/>

        <property name="sueldoBase"
                  column="sueldo_base"
                  type="double"
                  not-null="true"/>

    </class>

</hibernate-mapping>