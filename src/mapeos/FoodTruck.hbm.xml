<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="datos">

    <joined-subclass name="FoodTruck"
                     extends="UnidadDeVenta"
                     table="food_truck">

        <key column="id_unidad_venta"/>

        <property name="patente"
                  column="patente"
                  type="string"
                  not-null="true"/>

        <property name="usaElectricidad"
                  column="usa_electricidad"
                  type="boolean"
                  not-null="true"/>

    </joined-subclass>

</hibernate-mapping>