<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="datos">

    <class name="Pedido" table="pedido">

        <id name="id" column="id_pedido" type="long">
            <generator class="identity"/>
        </id>

        <property name="fecha" column="fecha" type="java.time.LocalDate" not-null="true"/>

        <many-to-one name="unidadDeVenta" 
        class="UnidadDeVenta" 
        column="id_unidad_venta" 
        not-null="true"/>
        
        <set name="detallePedido" inverse="true">
            <key column="id_pedido"/>
            <one-to-many class="DetallePedido"/>
        </set>

    </class>

</hibernate-mapping>