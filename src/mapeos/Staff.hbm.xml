<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="datos">

    <class name="Staff"
           table="staff"
           abstract="true">

        <id name="id"
            column="id_staff"
            type="long">
            <generator class="identity"/>
        </id>

        <property name="nombre"
                  column="nombre"
                  type="string"
                  not-null="true"/>

        <property name="apellido"
                  column="apellido"
                  type="string"
                  not-null="true"/>

        <property name="dni"
                  column="dni"
                  type="long"
                  not-null="true"/>

        <property name="fechaNacimiento"
                  column="fecha_nacimiento"
                  type="java.time.LocalDate"
                  not-null="true"/>

        <property name="fechaIngreso"
                  column="fecha_ingreso"
                  type="java.time.LocalDate"
                  not-null="true"/>

        <property name="sueldoBase"
                  column="sueldo_base"
                  type="double"
                  not-null="true"/>

    </class>

</hibernate-mapping>