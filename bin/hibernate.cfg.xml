<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- CONEXIÓN MYSQL -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/objetos2?serverTimezone=America/Argentina/Buenos_Aires
        </property>

        <property name="hibernate.connection.username">
            root
        </property>

        <property name="hibernate.connection.password">
            4869
        </property>

        <!-- DIALECTO -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <!-- SQL EN CONSOLA -->
        <property name="hibernate.show_sql">
            true
        </property>

        <property name="hibernate.format_sql">
            true
        </property>

        <!-- ACTUALIZAR ESQUEMA -->
        <property name="hibernate.hbm2ddl.auto">
            update
        </property>

        <!-- MAPEOS -->
        <mapping resource="mapeos/Staff.hbm.xml"/>
        <mapping resource="mapeos/Cajero.hbm.xml"/>
        <mapping resource="mapeos/Cocinero.hbm.xml"/>

        <mapping resource="mapeos/Festival.hbm.xml"/>

        <mapping resource="mapeos/Plato.hbm.xml"/>
        <mapping resource="mapeos/DetallePedido.hbm.xml"/>
        <mapping resource="mapeos/Pedido.hbm.xml"/>

        <mapping resource="mapeos/UnidadDeVenta.hbm.xml"/>
        <mapping resource="mapeos/FoodTruck.hbm.xml"/>
        <mapping resource="mapeos/PuestoDesarmable.hbm.xml"/>

    </session-factory>

</hibernate-configuration>